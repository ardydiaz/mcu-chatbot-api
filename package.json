{
  "name": "mcu-chatbot-api",
  "version": "1.0.0",
  "description": "University chatbot API built with Node.js, Express, MySQL, and PDF processing.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "qdrant:reindex": "node scripts/reindexQdrant.js",
    "images:reprocess": "node scripts/reprocessDocumentImages.js",
    "website:import": "node scripts/importWebsite.js"
  },
  "keywords": [
    "chatbot",
    "express",
    "mysql",
    "pdf"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
